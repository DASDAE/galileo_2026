# ---------------------------------------------------------------------------
# Tutorial-specific
# ---------------------------------------------------------------------------

# Exploratory notebooks. Keep the numbered ones at the repo root tidy.
scratch/

# Local review notes.
.scratch/

# Rendered slides. The published copy is built by the publish workflow.
_site/
.quarto/

# DASCore index files. These are generated on first use and they embed
# absolute paths, so they must never be committed.
.dascore_index.*

# Plots built straight from the operator's survey. These embed the real
# survey coordinates, which the published inventory deliberately does not
# carry, so they must not be committed. The tracked galileo_2026/data/docs/geometry.html is
# rebuilt from galileo_2026/data/inventory's local frame, and is fine.
galileo_2026/data/*georeferenced*.html

